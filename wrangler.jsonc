{
  "name": "hiring-scout-example",
  "main": "scheduler.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": []
  },
  "kv_namespaces": [
    {
      "binding": "SCOUT_STATE",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "FUNCTION_ID": "REPLACE_WITH_YOUR_FUNCTION_ID",
    "EXPERIMENT_ENDS_AT": "2000-01-01T00:00:00.000Z"
  }
}
